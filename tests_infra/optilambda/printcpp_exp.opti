    ghost(assert_prop, "proof := admit(int * int * (int -> int) * (b >= a) * int * (bp1 = b + 1) -> reduce_int_sum(a, b, f) + f(b) = reduce_int_sum(a, bp1, f))", "reduce_int_sum_add_right <- proof");
    ghost(assert_prop, "proof := admit(int * int * (int -> int) * (b > a) * int * (ap1 = a + 1) -> reduce_int_sum(a, b, f) - f(a) = reduce_int_sum(ap1, b, f))", "reduce_int_sum_sub_left <- proof");
    ghost(assert_prop, "proof := admit(int * int * int * int * (int -> int) * (b >= a) * (ap1 = a + 1) * (bp1 = b + 1) -> reduce_int_sum(a, b, f) + (f(b) - f(a)) = reduce_int_sum(ap1, bp1, f))", "reduce_int_sum_slide <- proof");
