               sub_range: Range,
               big_range: Range,
               bound_check: is_subrange(sub_range, big_range);
      consumes for i in outer_range -> Group(big_range, items(i));
      produces Wand(for i in outer_range -> Group(sub_range, items(i)), for i in outer_range -> Group(big_range, items(i))),
               for i in outer_range -> Group(sub_range, items(i));
