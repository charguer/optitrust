      consumes _RO(f, for i in 0..n -> for j in 0..m -> items(i, j));
      produces _RO(f, for ij in 0..(n * m) -> items(ij / m, ij % m));
      __admitted();
    };


    ghost fun ro_group_uncollapse() {
      reverts ro_group_collapse;
      __admitted();
    };


    ghost fun group_focus() {
