    ghost(assert_prop, "proof := admit(int * int -> n + d - d = n)", "z_cancel_plus_minus <- proof");

    fun wrap_z_cancel_minus_plus(m) {
      requires n: int,
               d: int,
               m = n - d + d;
      ensures _Res = n;
      __admitted();
      return m;
      ghost(rewrite_linear, "inside := fun(v) -> _Res = v", "by := z_cancel_minus_plus");
    };

    ghost(assert_prop, "proof := admit(float * float -> n - d + d = n)", "r_cancel_minus_plus <- proof");
    ghost(assert_prop, "proof := admit(float * float -> n + d - d = n)", "r_cancel_plus_minus <- proof");

