    ghost fun tile_divides() {
      requires tile_count: int,
               tile_size: int,
               size: int,
               div_check: size = tile_count * tile_size,
               positive_tile_size: tile_size >= 0;
      consumes Group(0..size, items);
      produces for bi in 0..tile_count -> for i in 0..tile_size -> items(bi * tile_size + i);
      __admitted();
    };


    ghost fun untile_divides() {
      reverts tile_divides;
      __admitted();
