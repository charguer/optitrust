    ghost fun group_collapse() {
      requires n: int,
               m: int;
      consumes for i in 0..n -> for j in 0..m -> items(i, j);
      produces for ij in 0..(n * m) -> items(ij / m, ij % m);
      __admitted();
    };


    ghost fun group_uncollapse() {
      reverts group_collapse;
      __admitted();
    };


    ghost fun ro_group_collapse() {
      requires n: int,
