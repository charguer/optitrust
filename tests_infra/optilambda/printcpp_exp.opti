  fun two_forks_spe_twice() {
    letmut x = 0;
    let fork_out = ghost_begin(ghost(ro_fork_group, "H := x ~> CellOf(Any)(0)", "r := 0..5"));
    for<seq> i in 0..5 {
      strict;
      xreads x ~> CellOf(Any)(0);
      ghost(ro_split2, "f := #_1", "H := x ~> CellOf(Any)(0)");
      ghost(ro_split2, "f := #_1 / 2", "H := x ~> CellOf(Any)(0)");
      ghost(ro_fork_group, "f := #_1 / 2", "H := x ~> CellOf(Any)(0)", "r := 0..5");
      ghost(ro_fork_group, "f := #_1 / 2 / 2", "H := x ~> CellOf(Any)(0)", "r := 0..5");
      ghost(ro_allow_join2, "f := #_1 / 2", "H := x ~> CellOf(Any)(0)");
      for<seq> j in 0..5 {
        strict;
        xreads x ~> CellOf(Any)(0);
        __ignore(x + 1);
      };
      ghost(ro_join_group, "H := x ~> CellOf(Any)(0)", "r := 0..5");
      ghost(ro_allow_join2, "f := #_1", "H := x ~> CellOf(Any)(0)");
      ghost(ro_join_group, "H := x ~> CellOf(Any)(0)", "r := 0..5");
    };
    ghost_end(fork_out);
  };
}

