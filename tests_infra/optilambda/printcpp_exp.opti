    ghost fun assert_inhabited() {
      requires x: T;
      ensures x: T;
    };


    ghost fun define() {};


    ghost fun assert_prop() {
      requires P: Prop,
               proof: P;
      ensures proof: P;
    };


    ghost fun assert_eq() {
      requires x: int,
               y: int,
               eq: x = y;
    };


    ghost fun assert_alias() {};


    ghost fun rewrite_prop() {
      requires from: int,
               to: int,
               by: from = to,
               inside(from);
      ensures out: inside(to);
      __admitted();
    };


    ghost fun rewrite_linear() {
      requires from: int,
               to: int,
               by: from = to;
      consumes inside(from);
      produces inside(to);
      __admitted();
    };


    ghost fun rewrite_float_prop() {
      requires from: f32,
               to: f32,
               by: from = to,
               inside(from);
      ensures out: inside(to);
      __admitted();
    };


