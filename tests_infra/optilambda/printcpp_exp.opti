      requires matrix: ptr(T),
               n1: int,
               n2: int,
               a: int,
               b: int,
               MT: MemType;
      consumes for i in a..b -> for j in 0..n2 -> matrix[MINDEX2(n1, n2, i, j)] ~> CellOf(MT)(M(i, j));
      produces for i in 0..(b - a) -> for j in 0..n2 -> matrix[a * n2][MINDEX2(b - a, n2, i, j)] ~> CellOf(MT)(M(i + a, j));
      __admitted();
    };


