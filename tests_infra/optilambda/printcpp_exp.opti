      reads for i1 in 0..n1 -> for i2 in 0..n2 -> src[MINDEX2(n1, n2, i1, i2)] ~> CellOf(Any)(model(i1, i2));
      writes for i1 in 0..n1 -> for i2 in 0..n2 -> dest[MINDEX2(n1, n2, i1, i2)] ~> CellOf(Any)(model(i1, i2));
      __admitted();
      __ignore(memcpy(dest, src, n1 * n2 * sizeof(int)));
