    ghost fun matrix1_span_shift() {
      requires matrix: ptr(T),
               n1: int,
               a: int,
               b: int,
               MT: MemType;
      consumes for i in a..b -> matrix[MINDEX1(n1, i)] ~> CellOf(MT)(M(i));
      produces for i in 0..(b - a) -> matrix[a][MINDEX1(b - a, i)] ~> CellOf(MT)(M(i + a));
      __admitted();
    };


    ghost fun matrix1_span_unshift() {
      reverts matrix1_span_shift;
      __admitted();
    };


